// بررسی جداگانه‌ی `src/core` — نگهبان، نه منبع تنظیمات.
//
// از وقتی `tsconfig.json` هم `strict` است، این فایل از نظر نوع چیزی اضافه نمی‌کند؛
// ولی اگر روزی ریشه شل‌تر شد یا `include` باریک‌تر، `npm run typecheck:core` هنوز
// تضمین می‌کند هسته (perft/موتور/قواعد) با سخت‌گیرانه‌ترین تنظیم‌ها چک شود.
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"strict": true
	},
	"include": ["src/core/**/*.ts"]
}
